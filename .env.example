# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro FR provisionnés via Twilio (format E.164 : +33XXXXXXXXX)
TWILIO_PHONE_NUMBER=+33XXXXXXXXX
# Votre numéro admin pour les alertes internes
DESTINATION_PHONE_NUMBER=+33XXXXXXXXX

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# IMPORTANT: doit commencer par "eyJ" (JWT service_role, pas "sb_secret_")
# Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=VOTRE_CLE_STRIPE_ICI
# Stripe Dashboard → Webhooks → votre endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe Dashboard → Products → votre abonnement 399€/an → Price ID
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Resend (emails transactionnels) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Email de l'opérateur (vous) qui reçoit les notifications admin
ADMIN_EMAIL=votre@email.com
# Email expéditeur (doit appartenir à un domaine vérifié dans Resend)
FROM_EMAIL=noreply@decrocheai.online

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://decrocheai.online

# ── Serveur ───────────────────────────────────────────────────────────────────
# Clé secrète pour sécuriser GET /calls (chaîne aléatoire longue)
API_KEY=changez-moi-avec-une-cle-secrete-aleatoire
PORT=3000

# Développement local uniquement : désactive la validation de signature Twilio
# NE PAS activer en production
# SKIP_TWILIO_VALIDATION=true
