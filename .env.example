# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Numéro qui reçoit les alertes internes (votre propre numéro)
DESTINATION_PHONE_NUMBER=+33XXXXXXXXX

# Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé secrète pour sécuriser GET /calls (chaîne aléatoire longue)
API_KEY=changez-moi-avec-une-cle-secrete-aleatoire

# Serveur
PORT=3000

# Développement local uniquement : désactive la validation de signature Twilio
# NE PAS activer en production
# SKIP_TWILIO_VALIDATION=true
